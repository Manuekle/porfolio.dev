---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  image?: string;
}

const {
  title = "Manuel Erazo — Full-Stack & AI Developer",
  description =
    "Full-Stack & AI developer in Bogotá, Colombia. I ship products with Next.js, TypeScript and LLMs — from idea to production. Founder of GymRat+.",
  lang = "es",
  image = "/og-banner.png",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://manudev.vercel.app");
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);
const ogLocale = lang === "es" ? "es_CO" : "en_US";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://manudev.vercel.app/#website",
      url: "https://manudev.vercel.app/",
      name: "Manuel Erazo",
      inLanguage: ["es", "en"],
      publisher: { "@id": "https://manudev.vercel.app/#person" },
    },
    {
      "@type": "Person",
      "@id": "https://manudev.vercel.app/#person",
      name: "Manuel Esteban Erazo Medina",
      alternateName: ["Manuel Erazo", "Manuekle"],
      url: "https://manudev.vercel.app/",
      image: "https://manudev.vercel.app/assets/avatar.png",
      jobTitle: "Full-Stack & AI Developer",
      email: "mailto:meerazo7@hotmail.com",
      telephone: "+57-311-271-1242",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Bogotá",
        addressCountry: "CO",
      },
      sameAs: [
        "https://github.com/manuekle",
        "https://linkedin.com/in/manuekle",
        "https://instagram.com/manudev.jsx",
      ],
      knowsAbout: [
        "React",
        "Next.js",
        "TypeScript",
        "Node.js",
        "LLMs",
        "SaaS",
        "Product design",
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Manuel Erazo" />
    <meta
      name="keywords"
      content="Manuel Erazo, full-stack developer, AI developer, React, Next.js, TypeScript, LLM, SaaS, freelance, Bogotá, Colombia"
    />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#e9e7de" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131311" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />

    <!-- Icons / manifest -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Self-hosted type -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/font/inter/InterVariable.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/font/cooper/CooperLtBT_400-s.p.0ayak-z9t8l45.woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Manuel Erazo" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_CO"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Manuel Erazo — Full-Stack & AI Developer" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Manuel Erazo — Full-Stack & AI Developer" />

    <link rel="me" href="https://github.com/manuekle" />
    <link rel="me" href="https://linkedin.com/in/manuekle" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // Apply the stored theme before first paint to avoid a flash.
      try {
        const raw = localStorage.getItem("portfolio.prefs");
        const prefs = raw ? JSON.parse(raw) : null;
        if (prefs && (prefs.theme === "dark" || prefs.theme === "light" || prefs.theme === "blueprint")) {
          document.documentElement.dataset.theme = prefs.theme;
          const color = prefs.theme === "dark" ? "#131311" : prefs.theme === "blueprint" ? "#2e6fff" : "#e9e7de";
          document.querySelectorAll('meta[name="theme-color"]').forEach((el) => el.setAttribute("content", color));
        }
        if (prefs && (prefs.lang === "es" || prefs.lang === "en")) {
          document.documentElement.lang = prefs.lang;
        }
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
