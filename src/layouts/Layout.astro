---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  image?: string;
}

const {
  title = "Manuel Erazo — Desarrollador Full-Stack & IA",
  description =
    "Desarrollador Full-Stack & IA en Bogotá, Colombia. Next.js, TypeScript y LLMs — de la idea a producción.",
  lang = "es",
  image = "/og-banner.png",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://manudev.vercel.app");
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);
const ogLocale = lang === "es" ? "es_CO" : "en_US";
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Manuel Erazo" />
    <meta
      name="keywords"
      content="Manuel Erazo, desarrollador full-stack, desarrollador IA, React, Next.js, TypeScript, LLM, SaaS, freelance, Bogotá, Colombia"
    />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#e9e7de" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131311" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />

    <!-- Icons / manifest -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Self-hosted type -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/font/inter/InterVariable.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/font/cooper/CooperLtBT_400-s.p.0ayak-z9t8l45.woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Manuel Erazo" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Manuel Erazo — Desarrollador Full-Stack & IA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Manuel Erazo — Desarrollador Full-Stack & IA" />

    <script is:inline>
      // Apply the stored theme before first paint to avoid a flash.
      try {
        const raw = localStorage.getItem("portfolio.prefs");
        const prefs = raw ? JSON.parse(raw) : null;
        if (prefs && (prefs.theme === "dark" || prefs.theme === "light")) {
          document.documentElement.dataset.theme = prefs.theme;
        }
        if (prefs && (prefs.lang === "es" || prefs.lang === "en")) {
          document.documentElement.lang = prefs.lang;
        }
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
