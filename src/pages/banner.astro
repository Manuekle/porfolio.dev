---
import "allo-font/allo.css";
/* Private export stage: previews the generated assets, never a second design source. */
const images = [
  { title: "Portfolio · English", src: "/social/portfolio-og-en-2026-11.png", width: 1200, height: 630 },
  { title: "Portafolio · Español", src: "/social/portfolio-og-es-2026-11.png", width: 1200, height: 630 },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Social image exports — Manuel Erazo</title>
    <style>
      @font-face { font-family: "Myriad Pro"; src: url("/fonts/myriad-pro/regular.woff2") format("woff2"); }
      * { box-sizing: border-box; }
      :root { color-scheme: light; }
      body { margin: 0; padding: 40px 24px; background: #e7f2ff; color: #162438; font-family: "Myriad Pro", system-ui, sans-serif; letter-spacing: -0.04em; }
      main { width: min(1200px, 100%); margin: auto; }
      h1, h2 { font-family: "Allo", "Myriad Pro", system-ui, sans-serif; letter-spacing: -0.02em; }
      h1 { font-size: 26px; font-weight: 500; }
      h2 { margin-top: 40px; font-size: 18px; font-weight: 500; }
      img { display: block; width: 100%; height: auto; }
      a { display: inline-block; margin-top: 16px; color: #245bab; }
    </style>
  </head>
  <body>
    <main>
      <h1>Social image exports</h1>
      {images.map((asset) => (
        <section>
          <h2>{asset.title} · {asset.width} × {asset.height}</h2>
          <img src={asset.src} alt={asset.title} width={asset.width} height={asset.height} />
          <a href={asset.src} download>Download PNG</a>
        </section>
      ))}
    </main>
  </body>
</html>
