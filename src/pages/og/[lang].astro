---
/* Source of the social cards (public/social). Not linked anywhere: capture it
   at exactly 1200 × 630 and save the PNG, e.g.
   chrome --headless=new --window-size=1200,630 --screenshot=out.png <url> */
import "allo-font/allo.css";
import "../../styles/home.css";
import { blobatar } from "blobatar";
import { happy, idle, smug, surprised, thinking, wink } from "blobatar/expression";
import { AGENTS, PROFILE, T } from "../../data/home";
import type { Lang } from "../../data/portfolio";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}
const lang = Astro.params.lang as Lang;
const t = (b: { en: string; es: string }) => b[lang];
const MOODS = { idle, happy, thinking, wink, smug, surprised };
const faces = AGENTS.map((a) => blobatar(a.seed, { hue: 252, tone: a.tone, expression: MOODS[a.mood] }));
const tagline = { en: "SaaS products and AI agents", es: "Productos SaaS y agentes de IA" };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Social card · {lang.toUpperCase()}</title>
    <style>
      html,
      body {
        margin: 0;
        background: #fff;
        overscroll-behavior: none;
      }
      .og {
        position: relative;
        isolation: isolate;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: var(--blue-surface);
      }
      .og::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        opacity: 0.22;
        mix-blend-mode: overlay;
        background: var(--grain);
      }
      /* the white sheet with its rounded foot over the blue, as on the site */
      .sheet {
        position: absolute;
        inset: 0 0 176px;
        display: flex;
        align-items: center;
        gap: 56px;
        padding: 0 96px;
        border-radius: 0 0 44px 44px;
        background: #fff;
      }
      .portrait {
        position: relative;
        flex: none;
        width: 184px;
        height: 184px;
      }
      .portrait::before {
        content: "";
        position: absolute;
        inset: 18px;
        border-radius: 50%;
        background: conic-gradient(from 40deg, #00a3ff, #52d2e4, #0a84ff, #0058dc, #4da8ff, #00a3ff);
        filter: blur(22px);
        opacity: 0.4;
        transform: translateY(20px);
      }
      .portrait img {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06);
      }
      h1 {
        --tracking: -0.035em;
        margin: 0;
        color: var(--text);
        font-size: 136px;
        font-weight: 600;
        line-height: 0.95;
      }
      .role {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 22px 0 0;
        color: var(--muted);
        font-size: 36px;
        line-height: 1.2;
      }
      .flag {
        border-radius: 4px;
        box-shadow: 0 0 0 1px rgb(0 0 0 / 0.14);
      }
      .band {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        height: 176px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 96px;
        color: #fff;
      }
      .band strong {
        --tracking: -0.03em;
        display: block;
        font-family: var(--font-display);
        font-size: 40px;
        font-weight: 600;
        line-height: 1.1;
        text-shadow: 0 1px 2px rgb(0 40 120 / 0.15);
      }
      .band span {
        display: block;
        margin-top: 6px;
        color: rgb(255 255 255 / 0.82);
        font-size: 24px;
      }
      /* the agents, as an avatar stack on white chips */
      .crew {
        display: flex;
        flex-direction: row-reverse;
      }
      .crew i {
        display: grid;
        place-items: center;
        width: 84px;
        height: 84px;
        margin-left: -18px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 0 0 4px rgb(255 255 255 / 0.25), 0 12px 24px -12px rgb(0 30 100 / 0.6);
      }
      .crew svg {
        width: 70px;
        height: 70px;
      }
    </style>
  </head>
  <body>
    <div class="og">
      <div class="sheet">
        <div class="portrait">
          <img src="/assets/avatar.webp?v=faab900674b4" alt="" width="184" height="184" />
        </div>
        <div>
          <h1>Manuel</h1>
          <p class="role">
            {t(T.role)} · {t(PROFILE.location)}
            <svg class="flag" width="42" height="28" viewBox="0 0 3 2" aria-hidden="true">
              <path fill="#FCD116" d="M0 0h3v1H0z" />
              <path fill="#003893" d="M0 1h3v.5H0z" />
              <path fill="#CE1126" d="M0 1.5h3V2H0z" />
            </svg>
          </p>
        </div>
      </div>
      <div class="band">
        <div>
          <strong>{t(tagline)}</strong>
          <span>manudev.vercel.app</span>
        </div>
        <div class="crew" aria-hidden="true">
          {[...faces].reverse().map((svg) => <i set:html={svg} />)}
        </div>
      </div>
    </div>
  </body>
</html>
