---
import { T, TOOLS } from "../../data/home";
import type { Lang } from "../../data/portfolio";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="tools" aria-labelledby="tools-title">
  <h2 class="tools-title" id="tools-title">{T.tools[lang]}</h2>
  <ul class="tool-icons">
    {TOOLS.map((tool) => (
      <li title={tool.name}>
        <img src={`/assets/stack/${tool.icon}.svg`} alt={tool.name} width={tool.icon === "aws" ? 40 : 28} height="28" />
      </li>
    ))}
  </ul>
</div>

<style>
  .tools {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .tools-title {
    margin: 0 0 16px;
    color: var(--muted);
    font-family: var(--font);
    font-size: 14px;
    font-weight: 400;
  }
  .tool-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }
  .tool-icons picture,
  .tool-icons img {
    display: block;
  }
  .tool-icons img {
    height: 28px;
    object-fit: contain;
  }
  @media (max-width: 600px) {
    .tool-icons {
      gap: 14px;
    }
  }
</style>
