  chatDots: '<path d="M6.5 3.5h11a3.5 3.5 0 0 1 3.5 3.5v7.5a3.5 3.5 0 0 1-3.5 3.5h-3.9L12 20.6 10.4 18H6.5A3.5 3.5 0 0 1 3 14.5V7a3.5 3.5 0 0 1 3.5-3.5Z"/><g fill="currentColor" stroke="none"><circle cx="8" cy="10.75" r="1.2"/><circle cx="12" cy="10.75" r="1.2"/><circle cx="16" cy="10.75" r="1.2"/></g>',
  addCircle: '<circle cx="12" cy="12" r="9.25"/><path d="M12 7.5v9M7.5 12h9"/>',
  heart: '<path fill="currentColor" stroke="none" d="M11.951 21.003C11.691 21.003 11.431 20.943 11.211 20.773C8.551 18.833 5.781 16.693 3.731 13.753C3.011 12.713 2.041 11.103 2.001 9.063C1.951 6.613 3.341 4.363 5.461 3.443C7.591 2.523 10.121 3.063 11.911 4.823L11.991 4.903C12.071 4.823 12.151 4.743 12.231 4.673C14.231 2.853 17.021 2.493 19.151 3.773C21.361 5.103 22.441 7.843 21.801 10.453C21.231 12.743 19.831 14.483 18.531 15.893C16.751 17.813 14.671 19.413 12.871 20.723C12.651 20.883 12.301 21.013 11.941 21.013L11.951 21.003ZM7.621 5.003C7.151 5.003 6.691 5.093 6.261 5.283C4.881 5.883 3.971 7.383 4.001 9.023C4.021 10.173 4.451 11.283 5.371 12.613C7.141 15.163 9.601 17.113 12.001 18.883C13.721 17.623 15.511 16.223 17.071 14.533C18.251 13.253 19.411 11.813 19.871 9.973C20.311 8.213 19.591 6.373 18.131 5.493C16.741 4.653 14.951 4.913 13.581 6.163C13.391 6.333 13.211 6.533 13.041 6.723L12.051 7.763L10.511 6.263C9.681 5.453 8.631 5.013 7.611 5.013L7.621 5.003Z"/>',
  send: '<path fill="currentColor" stroke="none" fill-rule="evenodd" clip-rule="evenodd" d="M2.324 5.095C1.64 4.338 2.101 3 3.245 3L21 3C21.355 3 21.683 3.188 21.863 3.494C22.042 3.8 22.046 4.178 21.873 4.488L12.995 20.362C12.446 21.344 11.026 21.144 10.719 20.105L8.205 11.598L2.324 5.095ZM10.278 11.558L12.128 17.816L18.304 6.772L10.278 11.558ZM17.37 5L4.935 5L9.291 9.818L17.37 5Z"/>',
  menu: '<path d="M3.5 8.5h17M3.5 15.5h12"/>',
  gif: '<rect x="3" y="3" width="18" height="18" rx="4"/><text x="12" y="15.4" text-anchor="middle" font-size="8.2" font-weight="800" fill="currentColor" stroke="none" font-family="system-ui, sans-serif">GIF</text>',
} as const;
/* PhoneStatusBar: Apple's 9:41, cellular, wifi and battery (phone-frame.tsx). */
const STATUS = `<span>9:41</span>
      <span class="ig-status-icons">
        <svg width="17.6" height="12" viewBox="0 0 20.1074 13.5254" fill="currentColor" fill-opacity="0.85"><path d="M18.2617 13.5156C19.2773 13.5156 20.1074 12.6953 20.1074 11.6602L20.1074 1.85547C20.1074 0.820312 19.2773 0 18.2617 0C17.2363 0 16.416 0.820312 16.416 1.85547L16.416 11.6602C16.416 12.6953 17.2363 13.5156 18.2617 13.5156Z" /><path d="M12.793 13.5156C13.8086 13.5156 14.6387 12.6953 14.6387 11.6602L14.6387 4.90234C14.6387 3.87695 13.8086 3.04688 12.793 3.04688C11.7676 3.04688 10.9375 3.87695 10.9375 4.90234L10.9375 11.6602C10.9375 12.7051 11.7676 13.5156 12.793 13.5156Z" /><path d="M7.32422 13.5156C8.33984 13.5156 9.16992 12.6953 9.16992 11.6602L9.16992 7.68555C9.16992 6.66016 8.33984 5.83008 7.32422 5.83008C6.29883 5.83008 5.46875 6.66016 5.46875 7.68555L5.46875 11.6602C5.46875 12.6855 6.29883 13.5156 7.32422 13.5156Z" /><path d="M1.85547 13.5156C2.87109 13.5156 3.69141 12.6953 3.69141 11.6602L3.69141 10.0879C3.69141 9.07227 2.87109 8.25195 1.85547 8.25195C0.830078 8.25195 0 9.07227 0 10.0879L0 11.6602C0 12.6953 0.830078 13.5156 1.85547 13.5156Z" /></svg>
        <svg width="16.3" height="12.2" viewBox="0 0 17.1044 12.8027" fill="currentColor" fill-opacity="0.85"><path d="M0.383243 4.93164C0.832462 5.39062 1.51606 5.3125 2.08246 4.80469C3.86957 3.21289 6.08637 2.39258 8.55707 2.39258C11.018 2.39258 13.2543 3.23242 15.0317 4.80469C15.5883 5.3125 16.2719 5.37109 16.7309 4.92188C17.1899 4.45312 17.2485 3.75 16.7797 3.26172C14.8852 1.34766 11.7993 0 8.55707 0C5.31488 0 2.21918 1.35742 0.334415 3.27148C-0.144101 3.75-0.0855069 4.45312 0.383243 4.93164Z" /><path d="M3.49848 8.07617C4.00629 8.57422 4.66059 8.50586 5.23676 8.03711C6.1352 7.33398 7.3266 6.85547 8.55707 6.86523C9.78754 6.85547 10.9789 7.34375 11.8774 8.04688C12.4438 8.50586 13.1274 8.55469 13.6254 8.05664C14.1137 7.55859 14.1918 6.80664 13.6743 6.33789C12.4438 5.24414 10.6079 4.46289 8.55707 4.46289C6.49652 4.46289 4.66059 5.24414 3.43988 6.33789C3.00043 6.73828 2.88324 7.45117 3.49848 8.07617Z" /><path d="M7.6684 12.207C8.24457 12.7539 8.84027 12.7539 9.42621 12.207L10.4125 11.2695C10.9887 10.7129 11.1059 10.0195 10.4516 9.54102C9.93402 9.17969 9.27973 8.93555 8.55707 8.93555C7.81488 8.93555 7.17035 9.17969 6.66254 9.55078C6.00824 10.0195 6.1352 10.7227 6.71137 11.2695Z" /></svg>
        <svg width="26.2" height="12" viewBox="0 0 1272 585" fill="currentColor" fill-opacity="0.85"><rect width="1155" height="585" rx="205" /><path d="M1192 196C1236 202 1272 253 1272 293C1272 333 1236 384 1192 390Z" /></svg>
      </span>`;
const glyph = (name: keyof typeof G, size: number, color = "#f5f5f5") =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:${color};flex-shrink:0">${G[name]}</svg>`;
---

<div class="ig-pair" aria-hidden="true">
<div class="ig-phone">
  <div class="ig-screen">
    <!-- CommentScreen: the post, dimmed, with the comments sheet slid up over it -->
    <div class="ig-surface ig-comment">
      <div class="ig-post-head">
        <span class="ig-post-back"><Fragment set:html={glyph("back", 28)} /></span>
        <div class="ig-post-title">
          <p>{COPY.posts}</p>
          <p>{account.handle}</p>
        </div>
      </div>
      <div class="ig-post-owner">
        <img class="ig-av" src={account.picture} alt="" width="32" height="32" />
        <p>{account.handle}</p>
        <Fragment set:html={glyph("menu", 24)} />
      </div>
      <div class="ig-post"><p>{COPY.caption.replace("{keyword}", KEYWORD)}</p></div>
      <div class="ig-scrim"></div>
      <div class="ig-sheet">
        <span class="ig-grabber"></span>
        <div class="ig-sheet-head">
          <p>{COPY.comments}</p>
          <span><Fragment set:html={glyph("send", 25)} /></span>
        </div>
        <div class="ig-comments">
          <div class="ig-c ig-arrive" style="--n:0">
            <Fragment set:html={defaultAvatar(36)} />
            <div class="ig-c-body">
              <p class="ig-c-meta"><b>{COPY.user}</b><span> {COPY.time}</span></p>
              <p class="ig-c-text">{KEYWORD}</p>
              <p class="ig-c-reply">{COPY.reply}</p>
            </div>
            <span class="ig-c-heart"><Fragment set:html={glyph("heart", 19, "#a8abb3")} /></span>
          </div>
          <div class="ig-c ig-c-is-reply ig-arrive" style="--n:1">
            <img class="ig-av" src={account.picture} alt="" width="26" height="26" />
            <div class="ig-c-body">
              <p class="ig-c-meta"><b>{account.handle}</b><span> {COPY.time}</span></p>
              <p class="ig-c-text">{COPY.publicReply}</p>
              <p class="ig-c-reply">{COPY.reply}</p>
            </div>
            <span class="ig-c-heart"><Fragment set:html={glyph("heart", 19, "#a8abb3")} /></span>
          </div>
        </div>
        <div class="ig-reactions">{REACTIONS.map((e) => <span>{e}</span>)}</div>
        <div class="ig-add">
          <Fragment set:html={defaultAvatar(42)} />
          <div class="ig-add-field">
            <span>{COPY.addComment.replace("{account}", account.handle)}</span>
            <Fragment set:html={glyph("gallery", 24)} />
            <Fragment set:html={glyph("gif", 24)} />
          </div>
        </div>
      </div>
    </div>
    <div class="ig-status" set:html={STATUS} />
  </div>
  <img class="ig-frame" src="/assets/works/oruka/iphone17.webp" alt="" width="754" height="1639" loading="lazy" />
</div>
<div class="ig-phone">
  <div class="ig-screen">
    <!-- DmScreen -->
    <div class="ig-surface">
      <div class="ig-head">
        <Fragment set:html={glyph("back", 28)} />
        <img class="ig-av" src={account.picture} alt="" width="34" height="34" />
        <div class="ig-who">
          <p class="ig-handle">{account.handle}</p>
          <p class="ig-sub">{COPY.businessChat}</p>
        </div>
        <span class="ig-actions">
          <Fragment set:html={glyph("call", 25)} />
          <Fragment set:html={glyph("video", 27)} />
          <Fragment set:html={glyph("tag", 25)} />
        </span>
      </div>

      <div class="ig-thread">
        <div class="ig-thread-inner">
          <div class="ig-profile">
            <img class="ig-av" src={account.picture} alt="" width="88" height="88" />
            <p class="ig-profile-name">{account.handle}</p>
            <p class="ig-profile-kind">{COPY.accountKind}</p>
            <span class="ig-profile-btn">{COPY.viewProfile}</span>
          </div>

          <p class="ig-context">
            {contextBefore}<b>{account.handle}</b>{contextAfter} <b>{COPY.seePost}</b>
          </p>

          <div class="ig-msgs">
            <div class="ig-in" style="--n:2">
              <img class="ig-av" src={account.picture} alt="" width="28" height="28" />
              <div class="ig-template">
                <p class="ig-template-text">{COPY.opening}</p>
                <p class="ig-template-btn">{COPY.button}</p>
              </div>
            </div>
            <div class="ig-out" style="--n:3"><p style="background:#7d3be8">{COPY.button}</p></div>
            <div class="ig-in" style="--n:4">
              <img class="ig-av" src={account.picture} alt="" width="28" height="28" />
              <div class="ig-template">
                <p class="ig-template-text">{COPY.follow}</p>
                <p class="ig-template-btn">{COPY.followButton}</p>
              </div>
            </div>
            <div class="ig-out" style="--n:5"><p style="background:#6a43ee">{COPY.followButton}</p></div>
            <div class="ig-in" style="--n:6">
              <img class="ig-av" src={account.picture} alt="" width="28" height="28" />
              <p class="ig-bubble">{finalText}<span class="ig-link">{finalLink}</span></p>
            </div>
          </div>
        </div>
      </div>

      <div class="ig-composer-wrap">
        <div class="ig-composer">
          <span class="ig-cam"><Fragment set:html={glyph("camera", 19, "#fff")} /></span>
          <span class="ig-placeholder">{COPY.message}</span>
          <Fragment set:html={glyph("mic", 24)} />
          <Fragment set:html={glyph("gallery", 24)} />
          <Fragment set:html={glyph("chatDots", 24)} />
          <Fragment set:html={glyph("addCircle", 24)} />
        </div>
      </div>
    </div>

    <div class="ig-status" set:html={STATUS} />
  </div>
  <img class="ig-frame" src="/assets/works/oruka/iphone17.webp" alt="" width="754" height="1639" loading="lazy" />
</div>
</div>
