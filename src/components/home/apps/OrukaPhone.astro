  tag: '<path d="M5 3h6a2 2 0 0 1 1.41.59l8 8a2 2 0 0 1 0 2.82l-6 6a2 2 0 0 1-2.82 0l-8-8A2 2 0 0 1 3 11V5a2 2 0 0 1 2-2Z"/><circle cx="7.6" cy="7.6" r="1.1" fill="currentColor" stroke="none"/>',
  camera: '<path fill="currentColor" stroke="none" fill-rule="evenodd" clip-rule="evenodd" d="M9.932 2C9.324 2 8.849 2.249 8.496 2.53C8.18 2.782 7.915 3.1 7.722 3.33L7.698 3.359C7.475 3.627 7.331 3.793 7.19 3.905C7.072 3.999 7.023 4 7 4L6.942 4C6.534 4 6.255 4 6.01 4.024C3.636 4.258 1.758 6.136 1.524 8.51C1.5 8.755 1.5 9.034 1.5 9.442L1.5 14.604C1.5 15.706 1.5 16.594 1.56 17.314C1.621 18.055 1.751 18.705 2.063 19.305C2.537 20.218 3.282 20.963 4.195 21.437C4.795 21.749 5.445 21.879 6.186 21.94C6.906 22 7.794 22 8.896 22H15.104C16.206 22 17.094 22 17.814 21.94C18.555 21.879 19.205 21.749 19.805 21.437C20.718 20.963 21.463 20.218 21.937 19.305C22.249 18.705 22.379 18.055 22.44 17.314C22.5 16.594 22.5 15.706 22.5 14.604L22.5 9.442C22.5 9.034 22.5 8.756 22.476 8.51C22.242 6.136 20.364 4.258 17.99 4.024C17.745 4 17.466 4 17.058 4L16.997 4C16.99 3.996 16.963 3.983 16.914 3.94C16.799 3.837 16.68 3.682 16.482 3.411L16.46 3.38C16.293 3.151 16.056 2.825 15.762 2.565C15.429 2.269 14.962 2 14.349 2H9.932ZM6.5 12.5C6.5 15.538 8.962 18 12 18C15.038 18 17.5 15.538 17.5 12.5C17.5 9.462 15.038 7 12 7C8.962 7 6.5 9.462 6.5 12.5ZM8.5 12.5C8.5 10.567 10.067 9 12 9C13.933 9 15.5 10.567 15.5 12.5C15.5 14.433 13.933 16 12 16C10.067 16 8.5 14.433 8.5 12.5Z"/>',
  mic: '<rect x="8.75" y="2.75" width="6.5" height="11.5" rx="3.25"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5v3.75M8.75 21.25h6.5"/>',
