---
/* Oruka's Instagram comment-automation preview, ported from the app:
   - screens: oruka/app/(app)/automations/_components/instagram-phone-preview.tsx (CommentScreen,
              then DmScreen: the comment that triggers the automation and the chat it opens)
   - glyphs:  oruka/app/(app)/automations/_components/instagram-glyphs.tsx
   - frame:   oruka/components/phone-frame.tsx (PhoneFrame, PhoneStatusBar) + public/frames/iphone17.png
   - copy:    oruka/lib/i18n/dictionary-product-{es,en}.ts (igComments.*), the automation's defaults
   Sizes are the app's own points on a 402pt-wide screen, scaled to the frame. */
import type { Lang } from "../../../data/portfolio";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const COPY = {
  es: {
    businessChat: "Chat de empresa",
    accountKind: "Cuenta de Instagram",
    viewProfile: "Ver perfil",
    context: "{account} te escribió por un comentario que hiciste en su publicación.",
    seePost: "Ver publicación",
    message: "Mensaje…",
    opening: "¡Hola! Gracias por comentar. Tocá el botón y te paso la demo.",
    button: "Quiero la demo",
    follow: "Para recibirla, primero seguinos y después tocá el botón.",
    followButton: "Ya los sigo",
    final: "¡Acá la tenés! https://",
    posts: "Publicaciones",
    caption: "Comenta {keyword}",
    comments: "Comentarios",
    user: "tu.cliente",
    time: "1 min",
    reply: "Responder",
    addComment: "Agrega un comentario para {account}",
    publicReply: "¡Listo! Te escribí por mensaje privado.",
  },
  en: {
    businessChat: "Business chat",
    accountKind: "Instagram account",
    viewProfile: "View profile",
    context: "{account} messaged you about a comment you made on their post.",
    seePost: "See post",
    message: "Message…",
    opening: "Hi! Thanks for commenting. Tap the button and I'll send you the demo.",
    button: "Send me the demo",
    follow: "To get it, follow us first and then tap the button.",
    followButton: "I follow you now",
    final: "Here it is! https://",
    posts: "Posts",
    caption: "Comment {keyword}",
    comments: "Comments",
    user: "your.customer",
    time: "1m",
    reply: "Reply",
    addComment: "Add a comment for {account}",
    publicReply: "Done! I sent you a private message.",
  },
}[lang];

/* The account as the commenter sees it; the business logo stands in for the
   profile picture, as the app does when the account has none. */
const account = { handle: "oruka", picture: "/assets/works/oruka/icon.webp" };
const [contextBefore, contextAfter] = COPY.context.split("{account}");
const [finalText, finalLink] = COPY.final.split(/(https?:\/\/\S*)/);
/* The automation's defaults: keyword DEMO, the first public reply. */
const KEYWORD = "DEMO";
const REACTIONS = ["❤️", "🙌", "🔥", "👏", "😢", "😍", "😮", "😂"];
/* Instagram's grey default avatar (DefaultAvatar). */
const defaultAvatar = (size: number) =>
  `<span class="ig-default" style="width:${size}px;height:${size}px"><svg width="${size}" height="${size}" viewBox="0 0 40 40" fill="#c7c9cc"><circle cx="20" cy="15.5" r="7"/><ellipse cx="20" cy="37" rx="14" ry="11"/></svg></span>`;

/* Instagram's own iOS glyphs on a 24pt grid (instagram-glyphs.tsx). */
const G = {
  back: '<path fill="currentColor" stroke="none" d="M6.293 11.312C5.902 11.702 5.902 12.336 6.293 12.726C6.327 12.761 6.364 12.792 6.402 12.82C6.428 12.855 6.458 12.889 6.49 12.921L13.293 19.726C13.683 20.117 14.316 20.117 14.707 19.726C15.098 19.336 15.098 18.703 14.707 18.312L8.415 12.018L14.976 5.457C15.367 5.067 15.367 4.433 14.976 4.043C14.586 3.652 13.952 3.652 13.562 4.043L6.293 11.312Z"/>',
