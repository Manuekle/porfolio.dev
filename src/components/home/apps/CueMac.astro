const ico = (name: keyof typeof I, cls = "") =>
  `<svg class="cm-ico ${cls}" viewBox="0 0 24 24" fill="none" aria-hidden="true">${I[name]}</svg>`;
---

<div class="cm-stage" aria-hidden="true">
  <div class="cm-mac">
    <img class="cm-frame" src="/assets/works/cue/macbook-frame.svg" alt="" width="2048" height="1237" loading="lazy" draggable="false" />
    <div class="cm-screen">
      <div class="cm-notch"></div>

      <div class="cm-panel" data-cue-prompter data-recording={COPY.recording} data-waiting={COPY.waiting}>
        <div class="cm-body">
          <div class="cm-pnotch"></div>
          <div class="cm-head">
            <span class="cm-mode"><b>{COPY.script}</b><span>{COPY.copilot}</span></span>
            <span class="cm-picker">{COPY.title}<Fragment set:html={ico("arrowDown")} /></span>
            <span class="cm-grow"></span>
            <span class="cm-detect"><i></i><span>{COPY.waiting}</span></span>
            <span class="cm-elapsed"><span class="cm-timer">0:00</span><span class="cm-rem">−0:00</span></span>
            <Fragment set:html={ico("more", "cm-more")} />
          </div>
          <div class="cm-window">
            <div class="cm-band"></div>
            <div class="cm-mask">
              <div class="cm-script">
                {COPY.lines.map((l) => <p>{l}</p>)}
              </div>
            </div>
            <svg class="cm-marker" viewBox="0 0 11 18" aria-hidden="true"><path d="M0 0L11 9L0 18Z" fill="currentColor" /></svg>
            <div class="cm-progress"><i></i></div>
            <div class="cm-countdown">
              <svg viewBox="0 0 100 100"><circle class="cm-track" cx="50" cy="50" r="45.5" /><circle class="cm-ring" cx="50" cy="50" r="45.5" /></svg>
              <b>3</b>
            </div>
          </div>
          <div class="cm-foot">
            <span class="cm-cbtn"><Fragment set:html={ico("previous")} /></span>
            <span class="cm-play"><Fragment set:html={ico("pause", "cm-i-pause")} /><Fragment set:html={ico("play", "cm-i-play")} /></span>
            <span class="cm-stepper"><Fragment set:html={ico("minus", "cm-pm")} /><span><Fragment set:html={ico("speed")} />140</span><Fragment set:html={ico("plus", "cm-pm")} /></span>
            <span class="cm-stepper"><Fragment set:html={ico("minus", "cm-pm")} /><span><Fragment set:html={ico("textSize")} />34</span><Fragment set:html={ico("plus", "cm-pm")} /></span>
            <span class="cm-grow"></span>
            <span class="cm-cbtn"><Fragment set:html={ico("mirror")} /></span>
          </div>
        </div>
      </div>

      <div class="cm-call">
        <div class="cm-callbar"><i></i><i></i><i></i></div>
        <img class="cm-feed" src="/assets/works/cue/meet.webp" alt="" width="2000" height="1250" loading="lazy" />
      </div>
    </div>
  </div>
</div>

<script>
  /* site/assets/main.js prompter(), unchanged in behaviour: waiting for the camera, the
     3-2-1 ring, scrolling at 140 wpm, a short pause, again. Runs only while on screen. */
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  document.querySelectorAll<HTMLElement>("[data-cue-prompter]").forEach((panel) => {
    const script = panel.querySelector<HTMLElement>(".cm-script")!;
    const win = panel.querySelector<HTMLElement>(".cm-window")!;
    if (reduce) {
      script.style.transform = `translateY(${win.clientHeight * 0.3}px)`;
      return;
    }
    const count = panel.querySelector<HTMLElement>(".cm-countdown")!;
    const countNum = count.querySelector("b")!;
    const timer = panel.querySelector<HTMLElement>(".cm-timer")!;
    const remain = panel.querySelector<HTMLElement>(".cm-rem")!;
    const progress = panel.querySelector<HTMLElement>(".cm-progress i")!;
    const detect = panel.querySelector<HTMLElement>(".cm-detect")!;
    const detectText = detect.querySelector("span")!;
    const words = (script.textContent ?? "").trim().split(/\s+/).length;
    const total = (words / 140) * 60;
    const clock = (t: number) => {
      t = Math.max(0, Math.floor(t));
      return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, "0")}`;
    };
    let p = 0;
    let raf = 0;
    let last = 0;
    let running = false;
    let phase = "idle";
    let gen = 0;

    const place = () => {
      script.style.transform = `translateY(${win.clientHeight * 0.3 - p * script.offsetHeight}px)`;
      progress.style.width = `${p * 100}%`;
      timer.textContent = clock(p * total);
      remain.textContent = "−" + clock(total - p * total);
    };
    const setActive = (on: boolean) => {
      panel.classList.toggle("is-active", on);
      detect.classList.toggle("is-on", on);
      detectText.textContent = (on ? panel.dataset.recording : panel.dataset.waiting) ?? "";
    };
    async function cycle(myGen: number) {
      phase = "ready";
      p = 0;
      place();
      setActive(false);
      await sleep(1600);
      if (myGen !== gen) return;
      phase = "count";
      setActive(true);
      for (const n of [3, 2, 1]) {
        if (myGen !== gen) return;
        countNum.textContent = String(n);
        count.classList.remove("is-show");
        void count.offsetWidth;
        count.classList.add("is-show");
        await sleep(1000);
      }
      count.classList.remove("is-show");
      phase = "play";
    }
    function frame(t: number) {
      if (!running) return;
      const dt = last ? Math.min(t - last, 50) : 16;
      last = t;
      if (phase === "play") {
        p = Math.min(1, p + dt / 1000 / total);
        place();
        if (p >= 1) {
          phase = "done";
          const g = ++gen;
          sleep(1200).then(() => {
            if (g === gen) cycle(g);
          });
        }
      }
      raf = requestAnimationFrame(frame);
    }
    addEventListener("resize", place);
    place();
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          if (running) return;
          running = true;
          last = 0;
          raf = requestAnimationFrame(frame);
          if (phase === "idle") cycle(++gen);
        } else {
          running = false;
          cancelAnimationFrame(raf);
        }
      },
      { threshold: 0.2 },
    ).observe(win);
  });
</script>
