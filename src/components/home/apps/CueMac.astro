---
/* Cue on a MacBook during a Google Meet call: the hero of Cue's own site, ported as is.
   - markup + CSS: pronter/site/index.html (.stage .mac) and site/assets/style.css, where the
     notch panel is built from macOS/PrompterPanel.swift (600 × 332 pt on a 1512 pt screen, drawn 1.4×)
   - loop:         site/assets/main.js prompter(): waiting, 3-2-1 ring, 140 wpm, restart
   - assets:       site/assets/img (macbook-frame.svg, mac-wallpaper.webp, meet.webp)
   - Spanish:      the app's own labels (Localizable.xcstrings); the script is the site's, translated.
   Class names are prefixed `cm-` so the site's generic ones (.panel, .play, .more…) stay local. */
import type { Lang } from "../../../data/portfolio";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const COPY = {
  en: {
    script: "Script",
    copilot: "Copilot",
    title: "Product demo",
    recording: "Recording",
    waiting: "Waiting for camera",
    lines: [
      "Hi everyone, and welcome back. Today I want to show you something we've been building for months.",
      "It's a teleprompter that sits right under your camera, so you can look people in the eye and never lose your place.",
      "It starts the moment your camera turns on, and it stays hidden when you share your screen. Let's get into it.",
    ],
  },
  es: {
    script: "Guion",
    copilot: "Copiloto",
    title: "Demo del producto",
    recording: "Grabando",
    waiting: "Esperando cámara",
    lines: [
      "Hola a todos, y bienvenidos de nuevo. Hoy quiero mostrarles algo que llevamos meses construyendo.",
      "Es un teleprompter que va justo debajo de tu cámara, para que mires a la gente a los ojos y nunca pierdas el hilo.",
      "Arranca en cuanto se enciende la cámara y no aparece cuando compartes pantalla. Vamos a verlo.",
    ],
  },
}[lang];

