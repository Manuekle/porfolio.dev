---
import Icon from "./Icon.astro";
import { ACTIVITY, BIO, EXPERIENCE_ITEMS, CONTRIBUTIONS, PROFILE, T, WORK_CARDS, WORK_GROUPS } from "../../data/home";
import type { Lang } from "../../data/portfolio";
import Scene from "./Scene.astro";
import Tools from "./Tools.astro";
import TopBar from "./TopBar.astro";
import Rail from "./Rail.astro";
import End from "./End.astro";
import Agents from "./Agents.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (b: { en: string; es: string }) => b[lang];

const INLINE: Record<string, { name: string; href: string; logo?: string; self?: boolean }> = {
  services: { name: lang === "es" ? "servicios" : "services", href: lang === "es" ? "/es/services/" : "/services/", self: true },
  ragis: { name: "Ragis", href: "https://ragis.app/", logo: "/assets/works/ragis/ragis-logo.svg" },
  gymrat: { name: "GymRat+", href: "https://gymratplus.com", logo: "/assets/works/gymrat/icon.webp" },
  oruka: { name: "Oruka", href: "https://www.oruka.si/en", logo: "/assets/works/oruka/icon.webp" },
};
const bio = BIO[lang].map((p) => p.split(/(\{\w+\})/g));
const cv = `/assets/CV_Manuel_Erazo_${lang.toUpperCase()}.pdf`;
const rail = [
  { id: "intro", label: t(T.intro) },
  { id: "works-title", label: t(T.works_short) },
  { id: "agents-title", label: t(T.agentsShort) },
  ...WORK_GROUPS.map((g) => ({ id: `${g.id}-title`, label: t(g.title), sub: true })),
  { id: "contributions-title", label: t(T.contributions) },
  { id: "exp-title", label: t(T.experience) },
  { id: "act-title", label: t(T.activity) },
  { id: "final-title", label: t(T.contact) },
];
---

<a class="skip" href="#main">{t(T.skip)}</a>

<Rail lang={lang} items={rail} />

<div class="sheet">
<TopBar lang={lang} page="home" />
<div class="wrap">
  <main id="main">
    <!-- intro -->
    <section id="intro" class="intro fade-in">
      <div class="hero">
        <div class="hero-avatar">
          <span class="halo" aria-hidden="true"></span>
          <img src="/assets/avatar.webp?v=faab900674b4" alt={PROFILE.name} width="160" height="160" fetchpriority="high" />
        </div>
        <h1>Manuel</h1>
        <p class="hero-role">
          {t(T.role)} · {t(PROFILE.location)}
          <svg class="flag" width="21" height="14" viewBox="0 0 3 2" role="img" aria-label="Colombia">
            <path fill="#FCD116" d="M0 0h3v1H0z" />
            <path fill="#003893" d="M0 1h3v.5H0z" />
            <path fill="#CE1126" d="M0 1.5h3V2H0z" />
            <linearGradient id="flag-gloss" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#fff" stop-opacity=".35" />
              <stop offset=".5" stop-color="#fff" stop-opacity="0" />
              <stop offset="1" stop-color="#000" stop-opacity=".12" />
            </linearGradient>
            <path fill="url(#flag-gloss)" d="M0 0h3v2H0z" />
          </svg>
        </p>
      </div>

      <div class="bio">
        {
          bio.map((parts) => (
            <p>
              {parts.map((part) => {
                const key = part.match(/^\{(\w+)\}$/)?.[1];
                const l = key ? INLINE[key] : undefined;
                return l ? (
                  <a href={l.href} target={l.self ? undefined : "_blank"} rel={l.self ? undefined : "noopener"}>{l.logo && <img src={l.logo} alt="" width="18" height="18" />}<span>{l.name}</span></a>
                ) : (
                  part
                );
              })}
            </p>
          ))
        }
      </div>

      <div class="ctas">
        <a class="btn btn-blue" href={`mailto:${PROFILE.email}`}>
          <Icon name="mail" size={18} />
          <span>{t(T.contact)}</span>
        </a>
        <a class="btn btn-light" href={cv} target="_blank" rel="noopener">
          <Icon name="resume" size={18} />
          <span>{t(T.cv)}</span>
        </a>
      </div>

      <Tools lang={lang} />
    </section>

    <!-- works -->
    <section id="works" aria-labelledby="works-title">
      <h2 class="sec-title" id="works-title">{t(T.works)}</h2>
      <div class="works">
        {
          WORK_CARDS.map((w, i) => (
            <a class="card work" href={w.href} target="_blank" rel="noopener" data-work={w.id} data-layout={w.layout} data-tone={w.tone} style={`--card-bg:${w.bg}`}>
              <div class="work-bg">
                <Scene card={w} lang={lang} />
              </div>
              <div class="work-body">
                <div class="work-head">
                  <div class="work-name">
                    {w.logo ? (
                      <img class="work-logo" src={w.logo} alt="" width="28" height="28" loading={i < 2 ? "eager" : "lazy"} />
                    ) : (
                      <span class="work-logo work-mono" aria-hidden="true">{w.name[0]}</span>
                    )}
                    <h3>{w.name}</h3>
                  </div>
                  <span class="arrow-btn" aria-hidden="true">
                    <Icon name="external" />
                  </span>
                </div>
                <p>{t(w.desc)}</p>
                <ul class="facts">
                  {w.facts.map((f, j) => (
                    <li>
                      {j === 0 ? (
                        <Icon name="star" size={16} />
                      ) : (
                        <Icon name="computer" size={16} />
                      )}
                      <span>{t(f)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <Agents lang={lang} />

    {WORK_GROUPS.map((group) => (
      <section aria-labelledby={`${group.id}-title`}>
        <h2 class="sec-title" id={`${group.id}-title`}>{t(group.title)}</h2>
        <ul class="more">
          {group.projects.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener">
                <span class="more-name">{p.name}</span>
                <span class="more-desc">{t(p.tagline)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section aria-labelledby="contributions-title">
      <h2 class="sec-title" id="contributions-title">{t(T.contributions)}</h2>
      <ul class="more">
        {CONTRIBUTIONS.map((entry) => (
          <li>
            <a href={entry.href} target="_blank" rel="noopener">
              <span class="more-name">{t(entry.name)}</span>
              <span class="more-desc">{t(entry.desc)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- experience -->
    <section aria-labelledby="exp-title">
      <h2 class="sec-title" id="exp-title">{t(T.experience)}</h2>
      <ol class="timeline">
        {
          EXPERIENCE_ITEMS.map((e) => (
            <li>
              <span class="when">{t(e.when)}</span>
              <span class="what">
                {t(e.what)}
                {e.sub && <small>{t(e.sub)}</small>}
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- activity -->
    <section aria-labelledby="act-title">
      <h2 class="sec-title" id="act-title">{t(T.activity)}</h2>
      <ol class="timeline">
        {
          ACTIVITY.map((e) => (
            <li>
              <span class="when">{t(e.when)}</span>
              <span class="what">{t(e.what)}</span>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</div>
</div>

<End lang={lang} />

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cards = document.querySelectorAll<HTMLElement>(".work");
  if (reduce) {
    document.querySelectorAll<HTMLVideoElement>(".work video").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
    });
  } else if ("IntersectionObserver" in window) {
    // Scenes only drift (and videos only play) while their card is on screen.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const card = e.target as HTMLElement;
          card.toggleAttribute("data-live", e.isIntersecting);
          card.querySelectorAll("video").forEach((v) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause()));
        }
      },
      { threshold: 0.2 },
    );
    cards.forEach((c) => io.observe(c));
  } else {
    cards.forEach((c) => c.setAttribute("data-live", ""));
  }
</script>
