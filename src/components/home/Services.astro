---
import { ADDONS, CAPABILITIES, COPY, PACKAGES, PROFILE, SPEEDS, type Lang } from "../../data/portfolio";
import { T } from "../../data/home";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (b: { en: string; es: string }) => b[lang];
const s = COPY[lang].services;
const q = COPY[lang].quote;
const home = lang === "es" ? "/es/" : "/";
const from = lang === "es" ? "Desde" : "From";
const quoteMail = `mailto:${PROFILE.email}?subject=${encodeURIComponent(lang === "es" ? "Cotización de servicios" : "Services quote")}`;

/* data for the quote script */
const quoteData = {
  lang,
  email: PROFILE.email,
  packages: PACKAGES.map((p) => ({
    id: p.id,
    name: p.name[lang],
    base: parseInt(p.from.replace(/,/g, ""), 10),
    time: p.time[lang],
    cadence: p.cadence?.[lang] ?? "",
  })),
  addons: ADDONS.map((a) => ({ id: a.id, label: a.label[lang], usd: a.usd })),
  speeds: SPEEDS.map((x) => ({ id: x.id, label: x.label[lang], mult: x.mult })),
  t: { base: q.base, priority: q.priorityFee, total: q.total, time: q.time, step1: q.step1, step3: q.step3 },
};
---

<a class="skip" href="#main">{t(T.skip)}</a>

<div class="wrap">
  <nav class="lang-bar" aria-label={t(T.langs)}>
    <div class="lang-tabs">
      <a href="/services/" hreflang="en" lang="en" class:list={{ on: lang === "en" }} aria-current={lang === "en" ? "page" : undefined}>English</a>
      <a href="/es/services/" hreflang="es" lang="es" class:list={{ on: lang === "es" }} aria-current={lang === "es" ? "page" : undefined}>Español</a>
    </div>
  </nav>

  <main id="main">
    <!-- intro -->
    <section class="fade-in">
      <a class="back" href={home}>
        <img src="/assets/avatar.webp" alt="" width="28" height="28" />
        <span>{PROFILE.name}</span>
      </a>
      <h1 class="page-title">{s.title}</h1>
      <div class="bio">
        <p>{s.intro}</p>
      </div>
      <div class="contact-row">
        <a class="contact-main" href={quoteMail}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="3" />
            <path d="m4 7 8 6 8-6" />
          </svg>
          <span>{s.cta}</span>
        </a>
        <a class="contact-alt" href="#quote">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="5" y="3" width="14" height="18" rx="3" />
            <path d="M9 7h6M9 11h.01M12 11h.01M15 11h.01M9 14h.01M12 14h.01M15 14h.01M9 17h.01M12 17h.01M15 17h.01" />
          </svg>
          <span>{q.title}</span>
        </a>
      </div>
    </section>

    <!-- what I build -->
    <section aria-labelledby="offer-title">
      <h2 class="eyebrow" id="offer-title">{s.offerTitle}</h2>
      <ul class="tiles">
        {
          CAPABILITIES.map((c) => (
            <li class="tile">
              <h3>{t(c.title)}</h3>
              <p>{t(c.blurb)}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- pricing -->
    <section aria-labelledby="price-title">
      <h2 class="eyebrow" id="price-title">{s.priceTitle}</h2>
      <ul class="prices">
        {
          PACKAGES.map((p) => (
            <li class="price">
              <div class="price-main">
                <h3>{t(p.name)}</h3>
                <span class="price-time">{t(p.time)}</span>
                <ul class="price-list">
                  {p.includes.map((i) => (
                    <li>{t(i)}</li>
                  ))}
                </ul>
              </div>
              <div class="price-tag">
                <span>{from}</span>
                <strong>
                  ${p.from}
                  {p.cadence && <small>{t(p.cadence)}</small>}
                </strong>
                <span>USD</span>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="note">{s.note}</p>
    </section>

    <!-- instant quote -->
    <section id="quote" aria-labelledby="quote-title">
      <h2 class="eyebrow" id="quote-title">{q.title}</h2>
      <form class="quote" data-quote={JSON.stringify(quoteData)}>
        <fieldset>
          <legend>{q.step1}</legend>
          <div class="opts">
            {
              PACKAGES.map((p) => (
                <label class="opt">
                  <input type="radio" name="pkg" value={p.id} checked={p.id === "mvp"} />
                  <span class="opt-name">{t(p.name)}</span>
                  <span class="opt-sub">
                    {from} ${p.from}
                    {p.cadence ? ` ${t(p.cadence)}` : ""}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend>{q.step2}</legend>
          <div class="chips">
            {
              ADDONS.map((a) => (
                <label class="chip">
                  <input type="checkbox" name="addon" value={a.id} />
                  <span>
                    {t(a.label)} <em>+${a.usd.toLocaleString("en-US")}</em>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend>{q.step3}</legend>
          <div class="chips">
            {
              SPEEDS.map((x) => (
                <label class="chip">
                  <input type="radio" name="speed" value={x.id} checked={x.id === "std"} />
                  <span>
                    {t(x.label)} <em>{t(x.note)}</em>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="quote-total" aria-live="polite">
          <div>
            <span class="quote-label">{q.total}</span>
            <strong class="quote-usd" data-total>—</strong>
          </div>
          <div class="quote-time">
            <span class="quote-label">{q.time}</span>
            <span data-time>—</span>
          </div>
          <ul class="quote-rows" data-rows></ul>
          <p class="note">{q.note}</p>
          <div class="contact-row">
            <a class="contact-main" data-send href={quoteMail}><span>{q.send}</span></a>
            <button class="contact-alt" type="reset"><span>{q.restart}</span></button>
          </div>
        </div>
      </form>
    </section>

    <footer><a class="footer-link" href={home}>← {s.back}</a> · © 2026 {PROFILE.name}</footer>
  </main>
</div>

<script>
  type Data = {
    email: string;
    packages: { id: string; name: string; base: number; time: string; cadence: string }[];
    addons: { id: string; label: string; usd: number }[];
    speeds: { id: string; label: string; mult: number }[];
    t: Record<string, string>;
  };
  const fmt = (n: number) => "$" + n.toLocaleString("en-US");
  const round50 = (n: number) => Math.round(n / 50) * 50;

  document.querySelectorAll<HTMLFormElement>("form[data-quote]").forEach((form) => {
    const d: Data = JSON.parse(form.dataset.quote!);
    const out = {
      total: form.querySelector<HTMLElement>("[data-total]")!,
      time: form.querySelector<HTMLElement>("[data-time]")!,
      rows: form.querySelector<HTMLElement>("[data-rows]")!,
      send: form.querySelector<HTMLAnchorElement>("[data-send]")!,
    };

    const update = () => {
      const fd = new FormData(form);
      const pkg = d.packages.find((p) => p.id === fd.get("pkg")) ?? d.packages[0];
      const speed = d.speeds.find((s) => s.id === fd.get("speed")) ?? d.speeds[0];
      const picked = d.addons.filter((a) => fd.getAll("addon").includes(a.id));
      const sum = picked.reduce((n, a) => n + a.usd, 0);
      const total = round50((pkg.base + sum) * speed.mult);
      const fee = total - pkg.base - sum;
      const rows = [
        [`${d.t.base} · ${pkg.name}`, pkg.base],
        ...picked.map((a) => [a.label, a.usd] as const),
        ...(fee > 0 ? [[`${d.t.priority} (+${Math.round((speed.mult - 1) * 100)}%)`, fee] as const] : []),
      ];

      out.total.innerHTML = `${fmt(total)}${pkg.cadence ? ` <small>${pkg.cadence}</small>` : ""}`;
      out.time.textContent = pkg.time;
      out.rows.replaceChildren(
        ...rows.map(([label, amount]) => {
          const li = document.createElement("li");
          const a = document.createElement("span");
          const b = document.createElement("span");
          a.textContent = String(label);
          b.textContent = fmt(Number(amount));
          li.append(a, b);
          return li;
        }),
      );

      const lines = [
        `${d.t.step1}: ${pkg.name}`,
        ...picked.map((a) => `+ ${a.label} (${fmt(a.usd)})`),
        `${d.t.step3}: ${speed.label}`,
        `${d.t.time}: ${pkg.time}`,
        `${d.t.total}: ${fmt(total)} USD${pkg.cadence ? ` ${pkg.cadence}` : ""}`,
      ];
      out.send.href = `mailto:${d.email}?subject=${encodeURIComponent(`${d.t.total} · ${pkg.name}`)}&body=${encodeURIComponent(lines.join("\n"))}`;
    };

    form.addEventListener("change", update);
    // reset fires before the inputs change back, so recalc on the next task
    form.addEventListener("reset", () => setTimeout(update, 0));
    update();
  });
</script>
